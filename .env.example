# 本地 SQLite；正式 MySQL 请改 DB_DRIVER=mysql 并填写下方连接参数
DB_DRIVER=sqlite
SQLITE_PATH=.local/smartedu.db
# 必填：使用独立随机值（例如 openssl rand -hex 32）
JWT_SECRET=
# 仅空库首次启动时创建 admin 使用；设置至少 8 位独立密码
BOOTSTRAP_ADMIN_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=smartedu
# 课程文件与未完成分片，需持久化并备份
TRAINING_UPLOAD_DIR=.local/training-uploads
