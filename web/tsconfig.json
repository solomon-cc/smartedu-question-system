{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true, "skipLibCheck": true, "moduleResolution": "bundler", "isolatedModules": true,
    "resolveJsonModule": true, "esModuleInterop": true, "noEmit": true,
    "types": ["vite/client"], "baseUrl": ".", "paths": { "@/*": ["src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"], "exclude": ["legacy", "node_modules"]
}
