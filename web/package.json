{
  "name": "smartedu-question-bank-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\"",
    "build:company": "vue-tsc --noEmit && vite build --mode company && node scripts/company-assets.mjs",
    "dev:company": "vite --mode company --port 3001"
  },
  "dependencies": {
    "@arco-design/web-vue": "^2.58.0",
    "vue": "^3.5.30",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.2",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.0"
  }
}
